---
import { MainForm } from '../components/Form/Form';
import Layout from '../layouts/Layout.astro';
import { SHOW_LEAD_FORM } from '../config';

const services = [
  { icon: 'layers',       title: 'Монтаж мягкой кровли',           desc: 'Гибкая черепица по сплошному основанию — тихо, аккуратно, без гулкого дождя над спальней.' },
  { icon: 'grid',         title: 'Металлочерепица и профнастил',    desc: 'Считаем раскрой так, чтобы обрезков осталось минимум — вы платите за крышу, а не за мусор.' },
  { icon: 'wrench',       title: 'Ремонт и перекрытие',             desc: 'Находим, откуда на самом деле идёт вода. Часто дело не в покрытии, а в примыкании или ендове.' },
  { icon: 'droplets',     title: 'Гидроизоляция',                   desc: 'Плоские крыши, балконы, козырьки. Наплавляемая или мембрана — по состоянию основания.' },
  { icon: 'thermometer',  title: 'Утепление кровли',                desc: 'С вентзазором и пароизоляцией — чтобы летом не пекло, а зимой утеплитель оставался сухим.' },
  { icon: 'rain',         title: 'Водостоки и снегозадержание',     desc: 'Уклоны, воронки, кронштейны с нормальным шагом. Вода уходит от фундамента, а не в него.' },
  { icon: 'home',         title: 'Мансарды',                        desc: 'Из чердака — жилая комната: пирог кровли, окна, подшивка, финишная отделка изнутри.' },
  { icon: 'trash',        title: 'Демонтаж старой кровли',          desc: 'Снимаем, вывозим, убираем за собой. Двор после нас можно сразу мыть, а не разгребать.' },
];

const works = [
  { img: '/preview1.jpg', title: 'Металлочерепица под ключ',         meta: 'Симферополь · 2 этажа · 5 дней' },
  { img: '/preview2.jpg', title: 'Гибкая черепица, вальмовая крыша', meta: 'Симферопольский р-н · 168 м²' },
  { img: '/preview3.jpg', title: 'Профнастил на хозблок',            meta: 'Саки · 74 м² · 2 дня' },
  { img: '/preview4.jpg', title: 'Демонтаж и новая обрешётка',       meta: 'Бахчисарай · замена стропил' },
  { img: '/preview5.jpg', title: 'Гидроизоляция примыканий',         meta: 'Алушта · плоский участок' },
  { img: '/preview6.jpg', title: 'Подшивка свесов и софиты',         meta: 'Симферополь · финишный этап' },
];

const steps = [
  { icon: 'phone',    n: '01', title: SHOW_LEAD_FORM ? 'Звонок или заявка' : 'Звонок или сообщение',    desc: 'Спросим адрес, площадь и что беспокоит. Пять минут разговора.', active: true },
  { icon: 'ruler',    n: '02', title: 'Замер на объекте',     desc: 'Поднимаемся на крышу, смотрим стропила и узлы. Бесплатно.', active: false },
  { icon: 'wallet',   n: '03', title: 'Смета и договор',      desc: 'Материалы, работы, сроки — построчно. Цена в договоре не меняется.', active: false },
  { icon: 'hardhat',  n: '04', title: 'Монтаж',               desc: 'Своя бригада. Присылаем фото каждый день, даже если вы не в Крыму.', active: false },
  { icon: 'check',    n: '05', title: 'Приёмка и гарантия',   desc: 'Обходим крышу вместе, убираем за собой, отдаём гарантийный лист.', active: false },
];

const reviews = [
  { text: '«Крыша текла два года, мы уже смирились. Ребята приехали, нашли проблему в ендове — не стали уговаривать перекрывать всё. Сделали за три дня, зиму прошли сухими.»', initials: 'ОК', name: 'Ольга К.', sub: 'Симферополь, ремонт кровли' },
  { text: '«Я живу в Москве, дом строится под Бахчисараем. Каждый вечер приходили фото и короткое видео. Ни одного лишнего рубля сверх сметы — для меня это было главное.»', initials: 'ДС', name: 'Дмитрий С.', sub: 'Бахчисарай, металлочерепица' },
  { text: '«Заказывали мягкую кровлю на мансарду. Отдельное спасибо за уборку: после демонтажа во дворе не осталось ни гвоздя, а у нас маленькие дети.»', initials: 'АМ', name: 'Анна М.', sub: 'Алушта, мягкая кровля' },
];
---

<Layout
  title="Кровельные работы в Симферополе и Крыму — КРОВЭКСПЕРТ: монтаж и ремонт крыш с гарантией 10 лет"
  description="Профессиональные кровельные работы в Симферополе и по всему Крыму. Монтаж мягкой кровли, металлочерепицы, ремонт, гидроизоляция. Своя бригада, договор, гарантия 10 лет. Звоните: +7 (978) 024-13-45"
>

<!-- ─── HERO ─────────────────────────────────────────────── -->
<section id="top" class="kx-sec hero-sec">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="kx-hero hero-grid">
    <div class="hero-left">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">Симферополь и весь Крым</span>
      </div>
      <h1 class="kx-d hero-h1">Сделаем крышу, о которой вы&nbsp;больше не будете думать</h1>
      <p class="hero-lead">Мы кроем крыши в Крыму больше 6 лет — своей бригадой, без субподряда. Приезжаем, смотрим, честно говорим, что нужно, а что нет. Гарантия 10 лет.</p>
      <div class="hero-actions">
        <a href="tel:+79780241345" class="btn-primary lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81a19.79 19.79 0 0 1-3.07-8.67 2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 6a16 16 0 0 0 6.91 6.91l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Позвонить: +7 (978) 024-13-45
        </a>
        {SHOW_LEAD_FORM ? (
          <a href="#form" class="btn-inverse lg">Оставить заявку</a>
        ) : (
          <a href="https://wa.me/79780241345" target="_blank" rel="noopener" class="btn-inverse lg">Написать в WhatsApp</a>
        )}
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><span class="stat-num">6+</span><span class="stat-lbl">лет на кровлях Крыма</span></div>
        <div class="hero-stat"><span class="stat-num">10 лет</span><span class="stat-lbl">гарантия на работы</span></div>
        <div class="hero-stat"><span class="stat-num">Своя</span><span class="stat-lbl">бригада, без посредников</span></div>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-img-wrap">
        <img src="/preview1.jpg" alt="Укладка металлочерепицы, объект в Симферополе" class="hero-img" />
      </div>
      <div class="hero-badge-card">
        <span class="badge-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </span>
        <span class="badge-card-text">
          <span class="badge-card-title">Гарантия 10 лет</span>
          <span class="badge-card-sub">Договор, смета, сроки — на бумаге</span>
        </span>
      </div>
    </div>
  </div>
</section>

<!-- ─── УСЛУГИ ────────────────────────────────────────────── -->
<section id="services" class="kx-sec" style="background:var(--surface-subtle)">
  <div class="container">
    <div class="eyebrow" style="color:var(--solar-700)">Что мы делаем</div>
    <h2 class="kx-h2 sec-h2" style="color:var(--navy-900)">Кровля целиком или один проблемный участок</h2>
    <p class="sec-lead">Берёмся и за новый дом, и за старую крышу, которая течёт третью зиму. Скажем прямо, если хватит ремонта — переделывать всё не заставим.</p>
    <div class="kx-4 services-grid">
      {services.map(s => (
        <div class="service-card">
          <span class="service-icon">
            {s.icon === 'layers'      && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>}
            {s.icon === 'grid'        && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>}
            {s.icon === 'wrench'      && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>}
            {s.icon === 'droplets'    && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/></svg>}
            {s.icon === 'thermometer' && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>}
            {s.icon === 'rain'        && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 15.25"/><line x1="8" y1="19" x2="8" y2="21"/><line x1="12" y1="17" x2="12" y2="19"/><line x1="16" y1="19" x2="16" y2="21"/></svg>}
            {s.icon === 'home'        && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>}
            {s.icon === 'trash'       && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>}
          </span>
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── РАБОТЫ ────────────────────────────────────────────── -->
<section id="works" class="kx-sec" style="background:var(--surface-inverse)">
  <div class="container">
    <div class="works-head">
      <div>
        <div class="eyebrow" style="color:var(--solar-500)">Наши работы</div>
        <h2 class="kx-h2 sec-h2" style="color:#fff">Видео с объектов — как это выглядит вживую</h2>
        <p style="font:400 17px/1.65 var(--font-body);color:rgba(255,255,255,.7);margin:0;max-width:58ch">Снимаем сами, на телефон, без монтажа и красивых ракурсов. Так честнее: видно и покрытие, и обрешётку, и как уложен конёк.</p>
      </div>
      <a href="tel:+79780241345" class="btn-inverse sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81a19.79 19.79 0 0 1-3.07-8.67 2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 6a16 16 0 0 0 6.91 6.91l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Спросить про объект
      </a>
    </div>
    <div class="kx-3 works-grid">
      {works.map((w, i) => (
        <button type="button" class="work-card" data-index={i}>
          <img src={w.img} alt={w.title} class="work-img" />
          <span class="work-overlay" aria-hidden="true"></span>
          <span class="work-play" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </span>
          <span class="work-info">
            <span class="work-title">{w.title}</span>
            <span class="work-meta">{w.meta}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- ─── КАК РАБОТАЕМ ─────────────────────────────────────── -->
<section id="steps" class="kx-sec" style="background:var(--surface-page)">
  <div class="container">
    <div class="eyebrow" style="color:var(--solar-700)">Как работаем</div>
    <h2 class="kx-h2 sec-h2" style="color:var(--navy-900)">Пять шагов, и ни одного сюрприза в конце</h2>
    <div class="steps-wrap">
      <div class="steps-line" aria-hidden="true"></div>
      <div class="kx-5 steps-grid">
        {steps.map(s => (
          <div class="step-item">
            <span class={`step-icon ${s.active ? 'step-icon--active' : ''}`}>
              {s.icon === 'phone'   && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81a19.79 19.79 0 0 1-3.07-8.67 2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 6a16 16 0 0 0 6.91 6.91l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>}
              {s.icon === 'ruler'   && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 8.7l-6-6a1 1 0 0 0-1.4 0L2.3 14.3a1 1 0 0 0 0 1.4l6 6a1 1 0 0 0 1.4 0L21.3 10.1a1 1 0 0 0 0-1.4z"/><line x1="7.5" y1="10.5" x2="10" y2="8"/><line x1="13" y1="10" x2="15.5" y2="7.5"/></svg>}
              {s.icon === 'wallet'  && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>}
              {s.icon === 'hardhat' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2H2z"/><path d="M5 18V12a7 7 0 0 1 14 0v6"/><path d="M12 2v3"/></svg>}
              {s.icon === 'check'   && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>}
            </span>
            <span class={`step-num ${s.active ? 'step-num--active' : ''}`}>ШАГ {s.n}</span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ─── ГАРАНТИЯ ──────────────────────────────────────────── -->
<section class="kx-sec" style="background:var(--surface-subtle)">
  <div class="container">
    <div class="kx-2 guarantee-grid">
      <div>
        <div class="eyebrow" style="color:var(--solar-700)">Гарантия</div>
        <h2 class="kx-h2 sec-h2" style="color:var(--navy-900)">10 лет — и это не формальность</h2>
        <p class="sec-lead">Мы никуда не уезжаем: работаем в Крыму больше 6 лет, и наши объекты стоят здесь же, в двадцати минутах езды. Если после нас где-то закапало — приедем и сделаем, без разговоров о том, кто виноват.</p>
        <p class="sec-lead" style="margin-top:16px">Гарантия распространяется на монтаж и герметичность узлов. На материалы действует гарантия производителя — её условия покажем ещё на этапе сметы.</p>
      </div>
      <div class="guarantee-cards">
        <div class="gcard gcard--accent">
          <span class="gcard-num">10 лет</span>
          <span class="gcard-lbl">гарантия на кровельные работы</span>
        </div>
        <div class="gcard">
          <span class="gcard-num">6+ лет</span>
          <span class="gcard-lbl">компания на рынке Крыма</span>
        </div>
        <div class="gcard">
          <span class="gcard-num">0 ₽</span>
          <span class="gcard-lbl">выезд и замер по Симферополю</span>
        </div>
        <div class="gcard">
          <span class="gcard-num">Своя</span>
          <span class="gcard-lbl">бригада — без субподряда</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── ГЕОГРАФИЯ ─────────────────────────────────────────── -->
<section id="geo" class="kx-sec" style="background:var(--surface-page)">
  <div class="container">
    <div class="kx-2 geo-grid">
      <div>
        <div class="eyebrow" style="color:var(--solar-700)">География</div>
        <h2 class="kx-h2 sec-h2" style="color:var(--navy-900)">База в Симферополе, работаем по всему Крыму</h2>
        <p class="sec-lead">До любой точки полуострова — не больше двух часов. Выезд на замер по Симферополю бесплатный, по остальным городам обсуждаем при звонке.</p>
        <div class="geo-tags">
          <span class="geo-tag geo-tag--main">Симферополь</span>
          {['Севастополь','Ялта','Алушта','Евпатория','Саки','Бахчисарай','Феодосия','Судак','Керчь','Джанкой','Белогорск'].map(c => (
            <span class="geo-tag">{c}</span>
          ))}
        </div>
      </div>
      <div class="geo-card">
        <div class="geo-card-eyebrow">Проще всего — позвонить</div>
        <a href="tel:+79780241345" class="geo-phone">+7 (978) 024-13-45</a>
        <p class="geo-card-text">Отвечает мастер, а не колл-центр. Можно просто описать проблему — подскажем, что делать, даже если заказывать вы пока не готовы.</p>
        <div class="geo-card-actions">
          <a href="https://wa.me/79780241345" target="_blank" rel="noopener" class="btn-primary sm">
