    { video: '/IMG_4673.MP4', poster: '/preview3.jpg', title: 'Профнастил на хозблок',            meta: 'Саки · 74 м² · 2 дня' },
    { video: '/IMG_4674.MP4', poster: '/preview4.jpg', title: 'Демонтаж и новая обрешётка',       meta: 'Бахчисарай · замена стропил' },
    { video: '/IMG_4675.MP4', poster: '/preview5.jpg', title: 'Гидроизоляция примыканий',         meta: 'Алушта · плоский участок' },
    { video: '/IMG_4676.MP4', poster: '/preview6.jpg', title: 'Подшивка свесов и софиты',         meta: 'Симферополь · финишный этап' },
  ];

  const overlay    = document.getElementById('work-modal') as HTMLElement;
  const modalVideo = document.getElementById('modal-video') as HTMLVideoElement;
  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const modalMeta  = document.getElementById('modal-meta')  as HTMLElement;
  const closeBtn   = document.getElementById('modal-close') as HTMLElement;

  function openModal(i: number) {
    const w = WORKS[i];
    modalVideo.src    = w.video;
    modalVideo.poster = w.poster;
    modalTitle.textContent = w.title;
    modalMeta.textContent  = w.meta;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    modalVideo.play().catch(() => {});
  }

  function closeModal() {
    overlay.hidden = true;
    document.body.style.overflow = '';
    modalVideo.pause();
    modalVideo.src = '';
  }

  document.querySelectorAll('.work-card').forEach(btn => {
    btn.addEventListener('click', () => openModal(Number((btn as HTMLElement).dataset.index)));
  });
  overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(); });
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>

</Layout>
